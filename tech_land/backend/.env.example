# ===== SERVER =====
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ===== DATABASE =====
MONGO_URI=mongodb://127.0.0.1:27017/tect_land

# ===== JWT =====
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=change_this_to_another_long_random_secret
ADMIN_JWT_EXPIRES_IN=1d

# ===== OTP =====
OTP_EXPIRES_MINUTES=5
OTP_LENGTH=6

# ===== EMAIL (Nodemailer / SMTP) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Tect Store <no-reply@tect.com>"

# ===== SMS (mock/provider placeholder - plug in Twilio/local gateway) =====
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=

# ===== FILE UPLOAD =====
MAX_IMAGE_SIZE_MB=5
UPLOAD_BASE_URL=http://localhost:5000/uploads

# ===== SHIPPING / TAX (business rules) =====
DEFAULT_SHIPPING_CHARGE=60
VAT_PERCENTAGE=5

# ===== INITIAL ADMIN SEED (used by `npm run seed`) =====
ADMIN_SEED_NAME=Super Admin
ADMIN_SEED_EMAIL=admin@tect.com
ADMIN_SEED_PASSWORD=ChangeMe123!

