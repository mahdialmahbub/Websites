{
  "name": "resume-builder-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express 5 + MongoDB backend for the resume builder",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
