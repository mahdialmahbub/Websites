# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_NAME=Resume Builder

# Frontend origin (Next.js). Used for CORS, post-login redirects and the CSRF origin check.
CLIENT_URL=http://localhost:3000
# Extra allowed frontend origins, comma separated (optional)
EXTRA_ALLOWED_ORIGINS=

# URL the BROWSER uses to reach this API (no trailing slash, no /api).
# It is used to build the OAuth callback URLs: <API_PUBLIC_URL>/api/auth/google/callback
#   local dev:                       http://localhost:5000
#   prod, behind Next.js rewrites:   your FRONTEND url, e.g. https://app.example.com
#   prod, api on its own subdomain:  https://api.example.com
API_PUBLIC_URL=http://localhost:5000

# Frontend path users land on after a successful Google/LinkedIn login
POST_LOGIN_PATH=/

# Number of reverse proxies in front of this server (Render / Railway / Nginx = 1). Keep 0 locally.
TRUST_PROXY=0

# ─────────────────────────────────────────────────────────────
# Database: MongoDB Atlas > Connect > Drivers > copy the connection string
# ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/resume-builder?retryWrites=true&w=majority

# ─────────────────────────────────────────────────────────────
# Secrets (min 32 chars). Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ─────────────────────────────────────────────────────────────
SESSION_SECRET=
OTP_SECRET=

# ─────────────────────────────────────────────────────────────
# Session cookie
# ─────────────────────────────────────────────────────────────
SESSION_TTL_DAYS=7
# lax  = frontend and API share the same site (localhost, app.example.com + api.example.com, or Next.js rewrites)
# none = frontend and API are on different sites (HTTPS only, and some browsers block third-party cookies)
COOKIE_SAMESITE=lax
# Optional: set only for sub-domain setups, e.g. .example.com
COOKIE_DOMAIN=

# ─────────────────────────────────────────────────────────────
# E-mail for OTP codes. MAIL_PROVIDER = console | smtp | resend | sendgrid
#   console  = prints the code in the terminal (local development only)
#   smtp     = Nodemailer + any SMTP server (Gmail app password, Resend SMTP, Brevo ...)
#   resend   = Resend HTTPS API   (works on hosts that block SMTP ports)
#   sendgrid = SendGrid HTTPS API (works on hosts that block SMTP ports)
# ─────────────────────────────────────────────────────────────
MAIL_PROVIDER=console
MAIL_FROM="Resume Builder <no-reply@yourdomain.com>"

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

RESEND_API_KEY=
SENDGRID_API_KEY=

# ─────────────────────────────────────────────────────────────
# Social login (optional: the buttons answer 501 until configured)
# Redirect URIs to register at the provider:
#   <API_PUBLIC_URL>/api/auth/google/callback
#   <API_PUBLIC_URL>/api/auth/linkedin/callback
# ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────
# Cloudinary: cloudinary.com > Dashboard > API Keys
# ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=resume-builder

# ─────────────────────────────────────────────────────────────
# Limits
# ─────────────────────────────────────────────────────────────
MAX_RESUMES_PER_USER=10
